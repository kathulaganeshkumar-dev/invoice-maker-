{
  "name": "enterprise-invoice-manager",
  "version": "2.0.0",
  "description": "Complete Premium Invoice, Quotation, Inventory, and Business Management Desktop Application",
  "author": "Enterprise Management",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "ts-node src/server/index.ts",
    "start:prod": "node dist-server/index.js",
    "dev:server": "ts-node src/server/index.ts",
    "dev:vite": "vite",
    "dev:lite": "concurrently -k -n \"SERVER,VITE\" -c \"blue,green\" \"ts-node src/server/index.ts\" \"vite\"",
    "dev:4200": "concurrently -k -n \"SERVER,BUILD\" -c \"blue,yellow\" \"ts-node src/server/index.ts\" \"vite build --watch\"",
    "dev": "concurrently -k -n \"SERVER,VITE,ELECTRON\" -c \"blue,green,magenta\" \"ts-node src/server/index.ts\" \"vite\" \"cross-env WAIT_ON_WEB=true ts-node electron/launch.ts\"",
    "build:vite": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --external:electron --external:sqlite3 --external:pg --external:knex --outfile=dist-server/index.js",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:vite && npm run build:server && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "db:purge": "ts-node src/server/database/purge.ts",
    "package:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "package:update": "node scripts/package-update.js",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.enterprise.invoicemanager",
    "productName": "Enterprise Management",
    "npmRebuild": false,
    "directories": {
      "output": "version 2.0"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "assets/tesseract",
        "to": "assets/tesseract",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/fonts",
        "to": "assets/fonts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/templates",
        "to": "assets/templates",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-server/**/*",
      "package.json",
      "!tools/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.lic"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Enterprise Management",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "call-bind-apply-helpers": "^1.0.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "decimal.js": "^10.6.0",
    "dunder-proto": "^1.0.1",
    "es-errors": "^1.3.0",
    "es-object-atoms": "^1.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "get-intrinsic": "^1.3.0",
    "get-proto": "^1.0.1",
    "gopd": "^1.2.0",
    "knex": "^3.1.0",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "object-inspect": "^1.13.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "side-channel": "^1.1.1",
    "side-channel-list": "^1.0.1",
    "side-channel-map": "^1.0.1",
    "side-channel-weakmap": "^1.0.2",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.0.2",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
